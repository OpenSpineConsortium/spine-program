   "run.py": {
    "status": "applied",
    "sha256_before": "aef4ae395a0c23d63c5c50bcccc12f73c2f0170d61aacb48f5fad9e3f00de714",
    "sha256_after": "c6afcccd09a32057e1fac549308d27831a6c64a0560e7ea76c148b2c71b17ae1",
    "diff": "--- a/run.py\n+++ b/run.py\n@@ -11,6 +11,12 @@\n \n torch.manual_seed(42)\n \n+# POSE-FLIP DEVIATION (polypose_apply_pose_flip.py): the packaged DeepFluoro poses put the CT behind\n+# the source (rays hit at alpha in [-0.83, -0.63]; trilinear renders zero, the fit cannot move). Right-\n+# multiplying by diag(-1,-1,1,1) puts every intersection inside [0,1] and matches the real frame\n+# (NCC 0.13 -> 0.71, GT outline aligned; drr_diag3.json). Applied identically to training and eval poses.\n+_POSE_FLIPZ = torch.diag(torch.tensor([-1.0, -1.0, 1.0, 1.0]))\n+\n \n def load_xrays(xrays, frames):\n     # Load ground truth X-ray images and camera poses\n@@ -19,6 +25,7 @@\n     for idx in frames:\n         xray, *_ = read_xray(f\"{xrays}/{idx:03d}.dcm\", crop=100)\n         pose, *_ = torch.load(f\"{xrays}/{idx:03d}.pt\", weights_only=False)[\"pose\"]\n+        pose = pose @ _POSE_FLIPZ.to(pose)  # POSE-FLIP DEVIATION (polypose_apply_pose_flip.py): see header\n         imgs.append(xray)\n         poses.append(pose)\n     gt = torch.concat(imgs).cuda()\n"
   },
   "eval.py": {
    "status": "applied",
    "sha256_before": "319a5b964bf96cee447cb9d151beee6fa061c4b4c19896b23c61e3ed40ccdb23",
    "sha256_after": "00c5ce0589ec0406f9d1f0ab6bdf2f1f5b6244d2da2803b6ae18085caa925417",
    "diff": "--- a/eval.py\n+++ b/eval.py\n@@ -18,6 +18,12 @@\n warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"monai.metrics\")\n warnings.filterwarnings(\"ignore\", category=FutureWarning, module=\"monai.utils.deprecate_utils\")\n \n+# POSE-FLIP DEVIATION (polypose_apply_pose_flip.py): the packaged DeepFluoro poses put the CT behind\n+# the source (rays hit at alpha in [-0.83, -0.63]; trilinear renders zero, the fit cannot move). Right-\n+# multiplying by diag(-1,-1,1,1) puts every intersection inside [0,1] and matches the real frame\n+# (NCC 0.13 -> 0.71, GT outline aligned; drr_diag3.json). Applied identically to training and eval poses.\n+_POSE_FLIPZ = torch.diag(torch.tensor([-1.0, -1.0, 1.0, 1.0]))\n+\n \n def load_xrays(subject_id, xrays, segmentations, frames):\n     # Load ground truth X-ray images, segmentations, and camera poses\n@@ -31,6 +37,7 @@\n         try:\n             xray, *_ = read_xray(f\"{xrays}/{idx:03d}.dcm\", crop=100)\n             pose, *_ = torch.load(f\"{xrays}/{idx:03d}.pt\", weights_only=False)[\"pose\"]\n+            pose = pose @ _POSE_FLIPZ.to(pose)  # POSE-FLIP DEVIATION (polypose_apply_pose_flip.py): see header\n         except FileNotFoundError:\n             break\n \n"
   }
  }
