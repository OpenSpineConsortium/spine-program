% nejm.cbx -- biblatex citation style after the cai4cai/RSNATemplate "nejm" style: numeric citations in
% parentheses, compressed ranges, in order of first citation, with natbib=true supplying \citep and \citet.
% A working minimal equivalent of the template's file (see TEMPLATE_NOTES.md).
\ProvidesFile{nejm.cbx}[2026/09/22 v0.1 NEJM/Vancouver-like numeric citation style]
\RequireCitationStyle{numeric-comp}
\ExecuteBibliographyOptions{sorting=none,autocite=inline}
\renewcommand*{\multicitedelim}{\addcomma}
\endinput
