% rsnaresults.sty -- results-driven numbers and figures for the SchwingNet manuscript.
%
% CONTRACT. No result number is typed into the prose. Each is \RESULT{key}, and each key is defined in
% generated/numbers.tex, which tools/results_macros.py writes at every build by reading the results files named in
% numbers_manifest.json (JSON pointer into the file, format, the grid job that produces it). A key whose file or
% pointer does not exist yet expands to a red "XXX Result Pending-<job>" marker, and tools/results_macros.py --check
% exits non-zero, so the document cannot be submitted with a pending result and no number can be invented in its
% place. Figures work the same way: \RESULTFIG{key} draws the file the manifest names when it exists and prints the
% marker when it does not. generated/numbers_audit.md records, for every key, the value, the file, its SHA-256 and
% the generation time, so the compiled PDF is traceable to the results files it was built from.
%
% Usage in the tex:
%   \RESULT{naming_lateral_pct}          -> 97.4
%   \RESULT{naming_lateral_kn}           -> 601/617
%   \RESULTFIG{figure6}                  -> \includegraphics{figures/figure6.pdf} or the pending marker
%   \RESULTSAY{key}{text if resolved}{text if pending}   -> conditional prose (a conclusion that waits on a result)
%   \RESULTSTATUS{key}                   -> "resolved" / "pending" (for tables and checks)
%
% REVIEW COPY (2026-09-25). rsnastyle.tex defines \ifcameraready (false = the double-anonymized review copy). In
% review mode \RESULTFIG{key} draws figures/review/<file> when that file exists and the manifest's file otherwise,
% so a figure whose review rendering has not been made still compiles; tools/check_limits.py lists which review
% files are absent and checks that the file actually drawn carries no network name.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rsnaresults}[2026/09/25 results-driven numbers and figures, review-copy figure fallback]
\RequirePackage{xcolor}
\RequirePackage{graphicx}

% \ifcameraready normally comes from rsnastyle.tex (loaded before this package); a document that loads the package
% alone gets the review default. \csname is used so that the skipped branch holds no \if token.
\expandafter\ifx\csname ifcameraready\endcsname\relax
  \expandafter\newif\csname ifcameraready\endcsname
\fi

% generated/numbers.tex defines, per key, \rsn@val@<key> (the formatted value) and \rsn@src@<key> (file#pointer),
% or \rsn@pend@<key> (the job id) when the result does not exist yet; per figure, \rsn@fig@<key> (the manifest's
% file), \rsn@figrev@<key> (figures/review/<basename>, the review copy) and \rsn@figjob@<key>. It is written by
% tools/results_macros.py.
\IfFileExists{generated/numbers.tex}{\input{generated/numbers.tex}}{%
  \PackageWarning{rsnaresults}{generated/numbers.tex is missing: run tools/results_macros.py before compiling}}

\newcommand{\rsn@pendingmark}[2]{{\bfseries\color{red}[XXX Result Pending-#2: #1]}}

% \RESULT{key}: the value, or the pending marker naming the job that will produce it.
\newcommand{\RESULT}[1]{%
  \ifcsname rsn@val@#1\endcsname
    \csname rsn@val@#1\endcsname
  \else
    \ifcsname rsn@pend@#1\endcsname
      \rsn@pendingmark{#1}{\csname rsn@pend@#1\endcsname}%
    \else
      \rsn@pendingmark{#1}{unknown key: not in numbers_manifest.json}%
    \fi
  \fi}

% \RESULTSAY{key}{resolved text}{pending text}: prose that depends on whether a result exists.
\newcommand{\RESULTSAY}[3]{\ifcsname rsn@val@#1\endcsname #2\else #3\fi}

% \RESULTSTATUS{key}
\newcommand{\RESULTSTATUS}[1]{\ifcsname rsn@val@#1\endcsname resolved\else pending\fi}

% \rsn@choosefig{key} sets \rsn@figfile: the manifest's file, or in review mode the review copy when it exists.
\newcommand{\rsn@choosefig}[1]{%
  \edef\rsn@figfile{\csname rsn@fig@#1\endcsname}%
  \ifcameraready\else
    \ifcsname rsn@figrev@#1\endcsname
      \IfFileExists{\csname rsn@figrev@#1\endcsname}{\edef\rsn@figfile{\csname rsn@figrev@#1\endcsname}}{}%
    \fi
  \fi}

% \RESULTFIG{key}: the chosen figure file if it exists on disk, else the pending marker.
% Optional first argument = includegraphics options.
\newcommand{\RESULTFIG}[2][width=\linewidth,height=0.88\textheight,keepaspectratio]{%
  \ifcsname rsn@fig@#2\endcsname
    \rsn@choosefig{#2}%
    \IfFileExists{\rsn@figfile}{\includegraphics[#1]{\rsn@figfile}}{%
      \rsn@pendingmark{#2}{\csname rsn@figjob@#2\endcsname}}%
  \else
    \rsn@pendingmark{#2}{unknown figure key}%
  \fi}

% Kept for compatibility with the older placeholder convention; tools/check_limits.py still reports them.
\providecommand{\PENDING}[2]{{\bfseries\color{red}[PENDING #1: #2]}}
\providecommand{\PENDINGFIG}[3]{\IfFileExists{#1}{\includegraphics[width=\linewidth]{#1}}{\PENDING{#2}{#3}}}
\endinput
